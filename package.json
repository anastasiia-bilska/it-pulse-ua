{
  "name": "it-pulse-ua",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "collect": "node --env-file-if-exists=.env src/collector/collect.ts",
    "seed:skills": "node --env-file-if-exists=.env src/taxonomy/seed.ts",
    "test": "node --test 'src/**/tests/*.test.ts' 'web/src/**/tests/*.test.ts' && npm run test:web",
    "typecheck": "tsc && tsc -p web",
    "test:integration": "node --test --test-concurrency=1 'src/**/tests/*.itest.ts'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract": "node --env-file-if-exists=.env src/extractor/extract.ts",
    "eval": "node --env-file-if-exists=.env src/evaluation/run-eval.ts",
    "eval:dataset": "node --env-file-if-exists=.env src/evaluation/build-dataset.ts",
    "dashboard": "node --env-file-if-exists=.env src/dashboard/build-dashboard.ts",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "preview:web": "vite preview web",
    "test:web": "vitest run --config web/vite.config.ts",
    "digest": "node --env-file-if-exists=.env src/digest/digest.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "79.0.0",
    "fontaine": "^1.0.3",
    "globals": "17.14.0",
    "happy-dom": "^21.0.4",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "sass-embedded": "^1.108.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
