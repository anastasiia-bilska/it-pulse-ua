# Cloudflare Pages response headers (ADR 0014).

# Vite puts a content hash in every file name here: a new build is a new URL, so the old one
# can be cached for a year and never revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page and its data change after every extract run: revalidate each visit (a cheap 304 when
# nothing changed), so a reader never sees numbers older than the last build.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/aggregates.json
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
